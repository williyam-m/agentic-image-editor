# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-...

DEEPSEEK_PRO_BASE_URL=https://<resource>.openai.azure.com/openai/v1/
DEEPSEEK_PRO_MODEL=DeepSeek-V4-Pro
DEEPSEEK_PRO_API_KEY=...

DEEPSEEK_FLASH_BASE_URL=https://<resource>.openai.azure.com/openai/v1/
DEEPSEEK_FLASH_MODEL=DeepSeek-V4.1-Flash
DEEPSEEK_FLASH_API_KEY=...

# Optional
# IMAGE_MODEL=gpt-image-2.5-flare
# IMAGE_QUALITY=medium

# ElevenLabs Scribe v2 (speech-to-text for voice editing)
ELEVENLABS_API_KEY=
